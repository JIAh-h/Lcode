{
  // 类型检查门禁（client 侧：Electron 渲染进程）。
  // 渲染层由 Vite 打包，因此用 Bundler 解析、允许 `.ts/.tsx` 后缀的导入，
  // 与 tsconfig.base.json 的 NodeNext 不同（那个是给 host 侧包的）。
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["vite/client"],
    "jsx": "react-jsx",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "verbatimModuleSyntax": false,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false
  },
  "include": ["apps/desktop/renderer/**/*.ts", "apps/desktop/renderer/**/*.tsx"],
  "exclude": ["**/node_modules", "**/dist", "**/lib"]
}
