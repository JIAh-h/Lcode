{
  "name": "@lcode/session-persistence-sqlite",
  "version": "0.1.0",
  "description": "Lcode 持久化实现：15 张表可执行 DDL + 索引写入（文档 22 §3，SQLite 索引层）",
  "type": "module",
  "private": true,
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./native": {
      "types": "./src/native.ts",
      "default": "./src/native.ts"
    }
  },
  "dependencies": {
    "@lcode/session": "workspace:*",
    "@lcode/session-persistence": "workspace:*",
    "@lcode/session-persistence-jsonl": "workspace:*",
    "@lcode/util": "workspace:*",
    "better-sqlite3": "^11.10.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json --noEmit",
    "probe": "node scripts/probe-sqlite.mjs",
    "native:build": "node scripts/build-native.mjs"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0"
  }
}
