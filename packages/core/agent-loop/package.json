    "@lcode/scope": "workspace:*",
    "@lcode/session": "workspace:*",
    "@lcode/system-prompt": "workspace:*",
    "@lcode/tools": "workspace:*",
    "@lcode/util": "workspace:*"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@lcode/llm-replay": "workspace:*"
  }
