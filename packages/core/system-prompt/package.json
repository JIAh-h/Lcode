  "dependencies": {
    "@lcode/context": "workspace:*",
    "@lcode/scope": "workspace:*",
    "@lcode/tools": "workspace:*",
    "@lcode/util": "workspace:*"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json --noEmit"
  }
}
