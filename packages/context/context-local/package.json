    "@lcode/context": "workspace:*",
    "@lcode/session": "workspace:*",
    "@lcode/session-api": "workspace:*",
    "@lcode/system-prompt": "workspace:*",
    "@lcode/util": "workspace:*"
  },
  "scripts": { "build": "tsc -p tsconfig.json --noEmit" }
}
