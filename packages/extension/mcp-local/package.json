{
  "name": "@lcode/mcp-local",
  "version": "0.1.0",
  "description": "MCP stdio 客户端：连接本地 MCP 服务并把工具注册进工具注册表",
  "type": "module",
  "private": true,
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "dependencies": {
