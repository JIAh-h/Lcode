{
  "name": "@lcode/desktop",
  "version": "0.1.0",
  "description": "Lcode 桌面应用：Electron main / preload / renderer（文档 10、20 §7.1；桌面端 CJS——Electron 33 ESM 主进程加载器有兼容问题）",
  "private": true,
  "main": "dist/main.js",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"node scripts/build-main.mjs --watch\" \"wait-on http://localhost:5173 tcp:5173 && node scripts/dev-electron.mjs\"",
    "build:electron": "node scripts/build-main.mjs",
    "build": "npm run build:renderer && npm run build:electron",
    "package:portable": "npm run build && node scripts/package-portable.mjs",
    "smoke:portable": "node scripts/smoke-portable.mjs",
    "start": "electron .",
    "typecheck": "tsc -p tsconfig.electron.json --noEmit && tsc -p tsconfig.json --noEmit",
    "build:main": "node scripts/build-main.mjs",
    "probe:preload": "electron scripts/probe-preload.cjs",
    "build:renderer": "vite build"
  },
  "dependencies": {
    "@lcode/approval": "workspace:*",
    "@lcode/lcode-desktop": "workspace:*",
    "@lcode/model-api": "workspace:*",
    "@lcode/session": "workspace:*",
    "@lcode/session-persistence-sqlite": "workspace:*",
    "@lcode/web-fetch": "workspace:^",
    "@lcode/web-search": "workspace:^",
    "better-sqlite3": "^11.10.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0"
  },
  "devDependencies": {
    "concurrently": "^9.1.0",
    "electron": "^33.2.0",
    "esbuild": "^0.25.12",
    "rcedit": "^5.0.2",
    "wait-on": "^8.0.1"
  }
}
