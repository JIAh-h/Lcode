{
  "$schema": "https://lcode.dev/schema/plugin-1.json",
  "id": "acme.house-rules",
  "name": "House Rules",
  "version": "0.1.0",
  "engines": { "lcode": "^0.1.0" },
  "entry": "./src/index.js",
  "permissions": {},
  "contributes": {
    "promptSections": ["acme-house-rules"]
  },
  "configSchema": {
    "type": "object",
    "properties": {
      "rules": {
        "type": "string",
        "description": "Standing instructions injected into every session",
        "default": "Answer in the user's language, keep responses concise."
      }
    }
  }
}
